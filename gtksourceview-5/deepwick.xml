<?xml version="1.0" encoding="UTF-8"?>
<!-- Deepwick is an unofficial theme derived from Polywick Blue by Polywick Studio (MIT).
     Generated by generate.py for GtkSourceView 5. -->
<style-scheme id="deepwick" name="Deepwick" version="1.0">
  <author>Deepwick contributors</author>
  <description>Deep navy with Visual Studio 2022 syntax colors.</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <color name="background" value="#04041a"/>
  <color name="blue" value="#569CD6"/>
  <color name="comment" value="#7A86A8"/>
  <color name="cyan" value="#4FC1FF"/>
  <color name="foreground" value="#D4D4D4"/>
  <color name="gold" value="#D7BA7D"/>
  <color name="green" value="#57A64A"/>
  <color name="lightBlue" value="#9CDCFE"/>
  <color name="magenta" value="#C586C0"/>
  <color name="muted" value="#6E7899"/>
  <color name="orange" value="#CE9178"/>
  <color name="overlay" value="#1B2140"/>
  <color name="red" value="#F44747"/>
  <color name="rose" value="#D16969"/>
  <color name="sage" value="#B5CEA8"/>
  <color name="selection" value="#264F78"/>
  <color name="surface" value="#10192C"/>
  <color name="teal" value="#4EC9B0"/>
  <color name="yellow" value="#DCDCAA"/>

  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="selection"/>
  <style name="selection-unfocused" background="overlay"/>
  <style name="cursor" foreground="foreground"/>
  <style name="secondary-cursor" foreground="muted"/>
  <style name="current-line" background="surface"/>
  <style name="current-line-number" foreground="foreground" background="surface"/>
  <style name="line-numbers" foreground="muted" background="background"/>
  <style name="line-numbers-border" background="background"/>
  <style name="right-margin" foreground="overlay"/>
  <style name="draw-spaces" foreground="overlay"/>
  <style name="background-pattern" background="overlay"/>
  <style name="bracket-match" background="overlay" bold="true"/>
  <style name="bracket-mismatch" foreground="red" underline="single"/>
  <style name="search-match" background="selection"/>
  <style name="map-overlay" background="overlay"/>
  <style name="snippet-focus" background="overlay"/>
  <style name="def:comment" foreground="comment" italic="true"/>
  <style name="def:shebang" foreground="comment" italic="true"/>
  <style name="def:doc-comment-element" foreground="comment" italic="true"/>
  <style name="def:keyword" foreground="blue"/>
  <style name="def:special-constant" foreground="blue"/>
  <style name="def:boolean" foreground="blue"/>
  <style name="def:statement" foreground="magenta"/>
  <style name="def:type" foreground="teal"/>
  <style name="def:function" foreground="yellow"/>
  <style name="def:builtin" foreground="yellow"/>
  <style name="def:identifier" foreground="lightBlue"/>
  <style name="def:constant" foreground="cyan"/>
  <style name="def:string" foreground="orange"/>
  <style name="def:character" foreground="orange"/>
  <style name="def:inline-code" foreground="orange"/>
  <style name="def:preformatted-section" foreground="orange"/>
  <style name="def:special-char" foreground="gold"/>
  <style name="def:number" foreground="sage"/>
  <style name="def:preprocessor" foreground="muted" bold="true"/>
  <style name="def:heading" foreground="blue" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="orange"/>
  <style name="def:link-destination" foreground="orange" underline="single"/>
  <style name="def:net-address" foreground="orange" underline="single"/>
  <style name="def:error" foreground="red" underline="error"/>
  <style name="def:reserved" foreground="red"/>
  <style name="def:deletion" foreground="red" strikethrough="true"/>
  <style name="def:insertion" foreground="green"/>
  <style name="def:note" foreground="background" background="yellow" bold="true"/>
  <style name="python:module-handler" foreground="magenta"/>
  <style name="python:class-name" foreground="teal"/>
  <style name="python:decorator" foreground="yellow"/>
  <style name="python:special-variable" foreground="blue"/>
  <style name="python:builtin-object" foreground="teal"/>
  <style name="c:keyword" foreground="magenta"/>
  <style name="c:type-keyword" foreground="blue"/>
  <style name="c:storage-class" foreground="blue"/>
  <style name="c:type" foreground="blue"/>
  <style name="c:included-file" foreground="orange"/>
  <style name="c:common-defines" foreground="cyan"/>
  <style name="js:regex" foreground="rose"/>
  <style name="js:regex-group" foreground="gold"/>
  <style name="js:directive" foreground="orange"/>
  <style name="js:template-placeholder" foreground="blue"/>
  <style name="js:built-in-property" foreground="lightBlue"/>
  <style name="js:built-in-constructor" foreground="teal"/>
  <style name="markdown:blockquote-marker" foreground="muted"/>
  <style name="markdown:label" foreground="lightBlue"/>
  <style name="html:element-name" foreground="blue"/>
  <style name="xml:element-name" foreground="blue"/>
  <style name="xml:attribute-name" foreground="lightBlue"/>
</style-scheme>
